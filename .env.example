# 复制为 .env 后填入密钥。请勿把 .env 提交或发给他人。
DEEPSEEK_API_KEY=
DEEPSEEK_API_BASE=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# 图片编辑：可复用方舟视频API Key；单独配置时优先使用SEEDREAM_API_KEY。
SEEDREAM_API_KEY=
# 可填写API根地址或完整的 /images/generations 地址，程序会自动识别。
SEEDREAM_API_BASE=https://ark.cn-beijing.volces.com/api/v3
# 方舟控制台创建的推理接入点ID（通常以 ep- 或 ark- 开头）。
SEEDREAM_MODEL=

# Seedance 2.5 的 API 模型 ID 需以你的即梦/火山账户控制台为准。
SEEDANCE_API_KEY=
SEEDANCE_API_BASE=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=
# 真人照片需先录入火山方舟可信素材库。只填控制台返回的 asset_id，不带 asset:// 前缀。
SEEDANCE_ASSET_ID=

# 单次真实生成预留费用；0 表示禁止真实付费生成。项目总预算上限 300 元。
REAL_JOB_RESERVE_RMB=0
MUSIC_PATH=
